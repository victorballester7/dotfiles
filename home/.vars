
# added nektar++ installation to the path
export PATH="$PATH:$HOME/Desktop/nektar/build/dist/bin"

# scripts PhD
export PATH="$PATH:$HOME/Desktop/PhD/scripts"

export PATH="$PATH:/usr/lib"

# for jekyll website
export PATH="$PATH:$HOME/.local/share/gem/ruby/3.4.0/bin"

export PATH="$PATH:$HOME/.local/bin"

# Use nvim for man pages
export MANPAGER='nvim +Man!'

# For fzf (fuzzy finding)
export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/config"

# for nektar library
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$HOME/Desktop/nektar/build/ThirdParty/dist/lib"

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/lib/"



# For Android development
export ANDROID_HOME=/opt/android-sdk
export PATH=$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin


# kitty
alias icat="kitten icat"
alias kssh="kitten ssh"

# nvim
alias nv="nvim"

# browsing directories
alias ls="lsd"
alias l="lsd -l"
alias la="lsd -a"
alias lla="lsd -la"
alias llt="lsd -l --tree"
alias lt="lsd --tree"
alias lta="lsd --tree --all"
alias llta="lsd --tree -la"
alias cd="z"
alias cp="cpx"
alias cat="bat"
